{
    "framework": null,
    "buildCommand": "npm run build && npm run migration:run && mkdir -p public && echo 'ready' > public/index.html",
    "outputDirectory": "public",
    "functions": {
        "api/index.ts": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index"
        }
    ]
}
